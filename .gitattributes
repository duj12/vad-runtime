# 构建相关文本文件统一 LF：避免 Windows 检出成 CRLF 后，
# 到 Linux 上 bash 报 "pipefail: invalid option name"、make 解析失败
Makefile            text eol=lf
*.sh                text eol=lf
*.cmake             text eol=lf
CMakeLists.txt      text eol=lf

# 二进制文件禁止换行转换，避免 Windows 检出时损坏
*.so     binary
*.so.*   binary
*.a      binary
*.onnx   binary
*.rknn   binary

# 随仓库携带的第三方依赖保持原始字节（头文件/许可证均为 LF）
third_party/onnxruntime/** -text
prebuilt/** -text
